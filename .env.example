# Glorp mentions service (compose.yaml, server/). Every value has a working
# default; set one only to change it. No secrets are needed.

# Host port for the service's plain HTTP (it serves /mentions and /health).
# Put HTTPS in front of it.
GLORP_MENTIONS_PORT=8087

# How long chat messages are kept in memory (Go duration, e.g. 90m, 2h).
KEEP=2h

# destiny.gg's chat socket, read anonymously.
CHAT_URL=wss://chat.destiny.gg/ws
